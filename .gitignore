# 설치 파일·빌드 결과
node_modules/
dist/
*.tsbuildinfo
.vite/

# 환경 변수 (Supabase 주소·키). 절대 저장소에 올리지 않습니다.
# 예시 파일(.env.example)만 올립니다.
.env
.env.*
!.env.example
*.local

# 백업·내보낸 데이터 (개인 기록이 들어 있을 수 있음)
backups/
*.backup.json
haru-habit-backup-*.json
localStorage-*.json

# 폰트 파일: 배포·재배포 허용 범위를 확인하기 전까지 저장소에 올리지 않음
# (확인 후 올리려면 아래 줄을 지우세요)
public/fonts/

# Supabase CLI 임시 파일
supabase/.temp/
supabase/.branches/

# 편집기·운영체제
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
